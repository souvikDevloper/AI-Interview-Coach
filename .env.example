# Never commit a real .env file. Copy this file to .env locally.

# Local Ollama is the paper-aligned default.
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud backend. Leave the key blank in committed files.
# LLM_BACKEND=groq
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=

# Optional: override default models
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RETRIEVE_K=4

# Optional: Whisper/local STT tuning
# WHISPER_MODEL=small.en
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE=auto
# WHISPER_ALLOW_FALLBACK=1
# WHISPER_DEVICE_INDEX=0
